<ui:FluentWindow x:Class="Telecom_ThesisProject.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Telecom_ThesisProject"
                 xmlns:viewModel="clr-namespace:Telecom_ThesisProject.MVVM.ViewModel"
                 xmlns:view="clr-namespace:Telecom_ThesisProject.MVVM.View"
                 mc:Ignorable="d"
                 Title="Telecom"
                 WindowStartupLocation="CenterScreen" 
                 MinHeight="550" MinWidth="800"
                 Height="620" Width="1050"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.DataContext>
        <viewModel:NavigationViewModel/>
    </ui:FluentWindow.DataContext>

    <Grid Background="#F4F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Telecom" VerticalAlignment="Top" Padding="5">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="5">

                    <Image Source="/Assets/logo_ic.png"
                           Width="25" 
                           Height="25" 
                           Stretch="Fill"
                           Margin="0,0,10,0"/>

                    <ui:TextBlock VerticalAlignment="Center" 
                                  TextWrapping="Wrap" Padding="0">
                        <Run Text="ТЕЛЕКОМ" FontSize="14" FontWeight="SemiBold"/>
                        <LineBreak/>
                        <Run Text="Специализированное решение"
                             FontSize="12" Style="{ui:ThemeResource ResourceKey=TextBlockSecondaryTextStyle}"/>
                    </ui:TextBlock>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border Margin="10,5,10,5" CornerRadius="8" Grid.Row="1" Background="{DynamicResource AccentFillColorDefaultBrush}">
            <view:TopMenuView HorizontalAlignment="Stretch"/>
        </Border>

        <ContentControl Grid.Row="2" Grid.ColumnSpan="2"
                        Background="#FFFFFF"
                        Margin="10"
                        Content="{Binding CurrentView}"/>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="#FFFFFF"/>
        <!--<Grid Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="{DynamicResource AccentFillColorDefaultBrush}"/>-->
        <ContentPresenter x:Name="RootContentDialogPresenter" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>  