<UserControl x:Class="Telecom_ThesisProject.MVVM.View.BindDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="750"
             Background="Transparent">

    <Border Padding="10"
            CornerRadius="10"
            Background="White">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding CancelCommand}"
                               Padding="10"
                               Margin="0,0,5,0"
                               ToolTip="Назад"/>

                    <ui:Button Icon="{ui:SymbolIcon Link24}"
                               Command="{Binding BindCommand}"
                               Padding="10"
                               ToolTip="Привязать оборудование" Appearance="Primary"/>

                    <Separator Margin="10,2"/>

                    <ui:TextBlock Text="Привязать оборудование"
                                  VerticalAlignment="Center"
                                  FontTypography="Subtitle"/>
                </StackPanel>

                <StackPanel Grid.Row="1">

                    <ui:CardExpander IsExpanded="True"
                                     Padding="10">

                        <ui:CardExpander.Header>
                            <ui:TextBlock FontTypography="BodyStrong">
                                Точка монтажа
                            </ui:TextBlock>
                        </ui:CardExpander.Header>

                        <Grid Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="Выберите точку монтажа"
                                          VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MountingPoints}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedMountingPointId}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal">

                                            <ui:TextBlock Text="{Binding PointType.Name}"/>

                                            <ui:TextBlock Text=" — "
                                                          Margin="5,0"/>

                                            <ui:TextBlock Text="{Binding LocationDescription}"
                                                          Appearance="Secondary"/>

                                        </StackPanel>

                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </Grid>

                    </ui:CardExpander>

                    <ui:CardExpander Margin="0,10,0,0"
                                     IsExpanded="True"
                                     Padding="10">

                        <ui:CardExpander.Header>
                            <StackPanel>

                                <ui:TextBlock FontTypography="BodyStrong">
                                    Свободное оборудование
                                </ui:TextBlock>

                                <ui:TextBlock FontTypography="Caption"
                                              Appearance="Secondary">
                                    Устройства без привязки к точке монтажа
                                </ui:TextBlock>

                            </StackPanel>
                        </ui:CardExpander.Header>

                        <Grid Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="Выберите устройство"
                                          VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FreeDevices}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedDeviceId}">
                                
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Text="{Binding Name}"/>
                                            <ui:TextBlock Text=" — "
                                                          Margin="5,0"/>
                                            <ui:TextBlock Text="{Binding IpAddress}"
                                                          Appearance="Secondary"/>
                                            <ui:TextBlock Text=" ("
                                                          Margin="5,0,0,0"/>
                                            <ui:TextBlock Text="{Binding DeviceType.TypeName}"
                                                          Appearance="Secondary"/>
                                            <ui:TextBlock Text=")"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </ui:CardExpander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>