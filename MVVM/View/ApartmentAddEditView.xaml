<UserControl x:Class="Telecom_ThesisProject.MVVM.View.ApartmentAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <Border Padding="10"
            CornerRadius="10"
            Background="White">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding CancelCommand}"
                               Padding="10"
                               Margin="0,0,5,0"/>

                    <ui:Button Icon="{ui:SymbolIcon Save20}"
                               Command="{Binding SaveCommand}"
                               Padding="10" Appearance="Primary"/>

                    <Separator Margin="10,2"/>

                    <ui:TextBlock Text="{Binding Title}"
                                      VerticalAlignment="Center"
                                      FontTypography="Subtitle"/>
                </StackPanel>

                <ui:CardExpander Grid.Row="1"
                                 IsExpanded="True"
                                 Padding="10" VerticalAlignment="Top">

                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="BodyStrong">
                            Информация о квартире
                        </ui:TextBlock>
                    </ui:CardExpander.Header>

                    <Grid Margin="0,10,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Text="Город"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Cities}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCityId}"/>

                        <ui:TextBlock Grid.Row="1"
                                      Text="Улица"
                                      Margin="0,12,0,0"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding Streets}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedStreetId}"/>

                        <ui:TextBlock Grid.Row="2"
                                      Text="Дом"
                                      Margin="0,12,0,0"/>

                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding Addresses}"
                                  DisplayMemberPath="HouseNumber"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedAddressId}"/>

                        <ui:TextBlock Grid.Row="3"
                                      Text="Номер квартиры"
                                      Margin="0,12,0,0"/>

                        <ui:TextBox Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,12,0,0"
                                    Text="{Binding ApartmentNumber}"
                                    PlaceholderText="Введите номер квартиры"/>

                    </Grid>

                </ui:CardExpander>

            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>