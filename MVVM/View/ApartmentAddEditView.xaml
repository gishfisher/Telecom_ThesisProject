<UserControl x:Class="Telecom_ThesisProject.MVVM.View.ApartmentAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400"
             Background="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="14pt" FontWeight="DemiBold" Margin="0,0,0,15"/>

            <Label Content="Город"/>
            <ComboBox ItemsSource="{Binding Cities}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCityId}"/>

            <Label Content="Улица"/>
            <ComboBox ItemsSource="{Binding Streets}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedStreetId}"/>

            <Label Content="Дом"/>
            <ComboBox ItemsSource="{Binding Addresses}"
                      DisplayMemberPath="HouseNumber"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedAddressId}"/>

            <Label Content="Номер квартиры"/>
            <TextBox Text="{Binding ApartmentNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,15,0,5"/>
            <Button Content="Назад" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
