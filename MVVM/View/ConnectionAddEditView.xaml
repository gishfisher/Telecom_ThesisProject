<UserControl x:Class="Telecom_ThesisProject.MVVM.View.ConnectionAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <Border Padding="10"
            Background="White"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding CancelCommand}"
                               ToolTip="Назад"
                               Margin="0,0,5,0"
                               Padding="10"/>

                    <ui:Button Icon="{ui:SymbolIcon Save20}"
                               Command="{Binding SaveCommand}"
                               Padding="10" Appearance="Primary"/>
                </StackPanel>

                <Separator Margin="5,2" Grid.Column="1"/>

                <ui:TextBlock Grid.Column="2"
                              Text="{Binding PageTitle, FallbackValue=Подключение}"
                              FontTypography="Subtitle"
                              VerticalAlignment="Center"/>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,10,0,0">

                <TabItem Header="Клиент">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="10,10,15,10">

                            <Label Content="Выбор абонента" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox ItemsSource="{Binding Clients}"
                                          DisplayMemberPath="GetFullName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedClientId, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>

                                <ui:Button Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Appearance="Secondary"
                                           Command="{Binding AddClientCommand}"
                                           Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" Foreground="Green" Margin="0,0,5,0"/>
                                        <TextBlock Text="Новый клиент"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <!--<Border CornerRadius="10" 
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    BorderThickness="1,0,0,0"
                                    Background="#26C8CCD2">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run FontWeight="SemiBold" Text="Важно: "/>
                                        <Run Text="Доступные устройства фильтруются по текущему"/>
                                        <Run FontWeight="SemiBold" Text="адресу"/>
                                        <Run Text="и привязке к"/>
                                        <Run FontWeight="SemiBold" Text="точке монтажа"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>-->

                            <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Location24" Margin="0,0,10,0"/>
                                        <ui:TextBlock Text="Адрес установки" FontTypography="BodyStrong"/>
                                    </StackPanel>
                                </Expander.Header>

                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Content="Город"/>
                                    <ComboBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10"
                                          ItemsSource="{Binding Cities}"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedCityId}"
                                          SelectedValuePath="Id"
                                          IsTextSearchEnabled="True"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Улица"/>
                                    <ComboBox Grid.Row="3" Grid.Column="0" Margin="0,0,5,0"
                                          ItemsSource="{Binding Streets}"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedStreetId}"
                                          SelectedValuePath="Id"/>

                                    <Label Grid.Row="2" Grid.Column="1" Content="Дом"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,5,0"
                                          ItemsSource="{Binding Addresses}"
                                          DisplayMemberPath="HouseNumber"
                                          SelectedValue="{Binding SelectedAddressId}"
                                          SelectedValuePath="Id"/>

                                    <Label Grid.Row="2" Grid.Column="2" Content="Кв/Офис"/>
                                    <ComboBox ItemsSource="{Binding Apartments}"
                                              SelectedValue="{Binding SelectedApartmentId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Text="{Binding ApartmentNumber, Mode=TwoWay}"
                                              DisplayMemberPath="Number"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              Grid.Row="3" Grid.Column="2"
                                              Margin="0,5"/>

                                </Grid>
                            </Expander>

                            <ui:HyperlinkButton Icon="{ui:SymbolIcon TextBulletListLtr24}"
                                                Content="Перейти к журналу адресов"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding OpenAddressesCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Сеть">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="10,10,15,10">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,5,0">
                                    <Label Content="Оборудование"/>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding SelectedDeviceId}"
                                              SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <Label Content="Порт"/>
                                    <ComboBox ItemsSource="{Binding DevicePorts}"
                                              DisplayMemberPath="PortName"
                                              SelectedValue="{Binding SelectedDevicePortId}"
                                              SelectedValuePath="Id"/>
                                </StackPanel>
                            </Grid>

                            <Expander Header="Карта портов" Margin="0,0,0,15">
                                <ui:DataGrid ItemsSource="{Binding DevicePorts}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True">
                                    <ui:DataGrid.Columns>
                                        
                                        <DataGridTextColumn Header="Id"
                                                            Binding="{Binding Id}"
                                                            Width="50"/>

                                        <DataGridTextColumn Header="Порт"
                                                            Binding="{Binding PortName}"
                                                            Width="100"/>

                                        <DataGridTextColumn Header="Есть подключения"
                                                            Binding="{Binding HasConnection}"
                                                            Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConnection}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasConnection}" Value="False">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                    </ui:DataGrid.Columns>
                                </ui:DataGrid>
                            </Expander>
                            
                            <Label Content="Статический IP"/>
                            <ui:TextBox Margin="0,0,10,15"
                                            PlaceholderText="0.0.0.0"
                                            Text="{Binding Connection.StaticIp}"/>

                            <Label Content="Тарифный план"/>
                            <ComboBox ItemsSource="{Binding Tariffs}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Connection.TariffId}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>