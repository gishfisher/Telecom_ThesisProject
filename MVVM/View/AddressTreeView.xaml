<UserControl x:Class="Telecom_ThesisProject.MVVM.View.AddressTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:vm="clr-namespace:Telecom_ThesisProject.MVVM.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>
        <DrawingImage x:Key="FolderIcon" x:Shared="False">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F59E0B" Geometry="M2 6a2 2 0 012-2h5l2 2h9a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CheckIcon" x:Shared="False">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#10B981" Geometry="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <HierarchicalDataTemplate DataType="{x:Type vm:CityNodeViewModel}" ItemsSource="{Binding Streets}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{StaticResource FolderIcon}" Width="18" Height="18" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:StreetNodeViewModel}" ItemsSource="{Binding Addresses}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{StaticResource FolderIcon}" Width="16" Height="16" Margin="0,0,6,0"/>
                <TextBlock FontSize="13" VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:AddressNodeViewModel}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{StaticResource CheckIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Подробнее"
                        Command="{Binding DetailsCommand}"
                        Padding="6,2"
                        FontSize="10"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Адреса"
                   FontSize="14pt"
                   FontWeight="DemiBold"
                   Foreground="#111827"
                   Padding="5"
                   Grid.Row="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Добавить город"
                    Command="{Binding AddCityCommand}"
                    Margin="0,0,5,0"/>
            <Button Content="Добавить улицу"
                    Command="{Binding AddStreetCommand}"
                    Margin="0,0,5,0"/>
            <Button Content="Добавить дом"
                    Command="{Binding AddAddressCommand}"
                    Margin="0,0,5,0"/>
            <Button Content="Редактировать"
                    Command="{Binding EditCommand}"
                    Margin="0,0,5,0"/>
            <Button Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Margin="0,0,5,0"/>
            <Button Content="Обновить"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <TreeView Grid.Row="2"
                  ItemsSource="{Binding Cities}"
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  BorderThickness="1"
                  BorderBrush="#E5E7EB">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
