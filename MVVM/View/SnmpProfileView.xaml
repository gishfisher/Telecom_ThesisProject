<UserControl x:Class="Telecom_ThesisProject.MVVM.View.SnmpProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500"
             Background="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="SNMP Профиль" FontSize="14pt" FontWeight="DemiBold" Margin="0,0,0,15"/>

            <Label Content="Наименование"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Community-Строка"/>
            <TextBox Text="{Binding CommunityString, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Порт"/>
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Версия"/>
            <ComboBox ItemsSource="{Binding SnmpVersions}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedSnmpVersionId}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding VersionName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>-->

            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,15,0,5"/>
            <Button Content="Назад" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
