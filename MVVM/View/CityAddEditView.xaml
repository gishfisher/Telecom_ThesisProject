<UserControl x:Class="Telecom_ThesisProject.MVVM.View.CityAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <Border Padding="10"
            CornerRadius="10"
            Background="White">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                           Command="{Binding CancelCommand}"
                           Padding="10"
                           Margin="0,0,5,0"/>

                <ui:Button Icon="{ui:SymbolIcon Save20}"
                           Command="{Binding SaveCommand}"
                           Padding="10"/>

                <Separator Margin="10,2"/>

                <ui:TextBlock Text="{Binding Title}"
                                  VerticalAlignment="Center"
                                  FontTypography="Subtitle"/>
            </StackPanel>

            <ui:CardExpander Grid.Row="1"
                             IsExpanded="True"
                             Padding="10" VerticalAlignment="Top">

                <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="BodyStrong">
                        Информация о городе
                    </ui:TextBlock>
                </ui:CardExpander.Header>

                <Grid Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Text="Название города"
                                  VerticalAlignment="Center"/>

                    <ui:TextBox Grid.Column="1"
                                Text="{Binding Name}"
                                PlaceholderText="Введите название города"/>

                </Grid>

            </ui:CardExpander>

        </Grid>
    </Border>
</UserControl>