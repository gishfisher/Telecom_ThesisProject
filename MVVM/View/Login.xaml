<UserControl x:Class="Telecom_ThesisProject.MVVM.View.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PBPassword" Margin="0,5"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,5"/>

            <Button Content="Войти" 
                Command="{Binding LoginCommand}" 
                CommandParameter="{Binding ElementName=PBPassword}"
                Margin="0,20,0,0" Height="35"/>
        </StackPanel>
    </Grid>
</UserControl>
