<UserControl x:Class="Telecom_ThesisProject.MVVM.View.RequestAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="#FFFFFF">

    <Border Margin="10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{Binding PageTitle}"
                       FontSize="14pt"
                       Padding="5"/>

                <DockPanel Grid.Row="1">
                    <Button Content="Назад"
                            Command="{Binding CancelCommand}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить заявку"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}">
                        </Button>

                        <Button Content="Редактировать заявку"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}">
                        </Button>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="3" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,15,10">
                            <Label Content="Статус"/>
                            <ComboBox ItemsSource="{Binding Statuses}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Request.StatusId, Mode=TwoWay}"
                                      Grid.Column="1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1">
                            <Grid Margin="0,0,15,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel  Grid.Column="0" Grid.Row="0">
                                    <Label Content="Номер заявки"/>
                                    <TextBox IsReadOnly="True"
                                             Margin="0,0,15,0"
                                             Text="{Binding Request.Id, StringFormat=\{0:D4\}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Дата"/>
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding Request.CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,15,0">
                            <Label Content="Клиент"/>
                            <ComboBox ItemsSource="{Binding Clients}"
                                      DisplayMemberPath="GetFullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Request.ClientId, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1">
                            <Label Content="Тип обращения"/>
                            <ComboBox ItemsSource="{Binding RequestTypes}"
                                      SelectedValue="{Binding Request.TypeId, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2">
                            <Label Content="Назначенный сотрудник"/>
                            <ComboBox ItemsSource="{Binding Employees}"
                                      DisplayMemberPath="GetFullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Request.EmployeeId, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,8,0,0">
                            <Label Content="Описание"/>
                            <TextBox TextWrapping="Wrap"
                                     Text="{Binding Request.Description}"
                                     Height="80"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
