<UserControl x:Class="Telecom_ThesisProject.MVVM.View.RequestAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="#FFFFFF">

    <Border Margin="10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="Auto"/>-->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="◀️ Назад"
                            Command="{Binding CancelCommand}"
                            Foreground="#94A3B8"
                            Margin="5,0,0,0"
                            Padding="8,4"
                            Cursor="Hand"/>

                    <Label Content="{Binding PageTitle}"
                           FontSize="14pt"
                           Padding="5"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="➕ Добавить заявку"
                                Background="#10B981"
                                Foreground="#FFFFFF"
                                Margin="5,0"
                                Padding="10,6"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}">
                            <Button.Visibility>
                                <Binding Path="IsNewRequest" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Button.Visibility>
                        </Button>

                        <Button Content="📝 Редактировать заявку"
                                Background="#2563EB"
                                Foreground="#FFFFFF"
                                Margin="5,0"
                                Padding="10,6"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}">
                            <Button.Visibility>
                                <Binding Path="IsExistingRequest" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Button.Visibility>
                        </Button>

                        <Button Content="🔘 Взять заявку" Background="#2563EB" Foreground="#FFFFFF" Visibility="Collapsed" Margin="5,0" Padding="10,6"/>
                        <Button Content="✅ Выполнить" Background="#10B981" Foreground="#FFFFFF" Visibility="Collapsed" Margin="5,0" Padding="10,6"/>
                        <Button Content="Начать работу" Background="#E27A53" Foreground="#FFFFFF" Visibility="Collapsed" Margin="5,0" Padding="10,6"/>
                        <Button Content="❎ Отменить заявку" Foreground="#EF4444" Visibility="Collapsed" Margin="5,0" Padding="10,6"/>
                        <Button Content="🎯 Закрыть заявку" Background="#94A3B8" Foreground="#FFFFFF" Visibility="Collapsed" Margin="5,0" Padding="10,6"/>
                    </StackPanel>
                </DockPanel>

                <Separator Grid.Row="2" Padding="5" Background="#94A3B8" Margin="0,4,0,8"/>

                <StackPanel Grid.Row="3" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                            <Label Content="Статус"/>
                            <StackPanel Orientation="Horizontal">
                                <Label>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="5"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Fill="#3B82F6"/>
                                        <TextBlock Text="{Binding Request.Status.Name, FallbackValue=—}"
                                                   FontSize="12pt"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Label>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1">
                            <Grid Margin="0,0,15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Label Content="Номер заявки"/>
                                    <TextBox IsReadOnly="True"
                                             Margin="0,0,15,0"
                                             Text="{Binding Request.Id, StringFormat=\{0:D4\}}"
                                             Tag="Номер"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Дата"/>
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding Request.CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                             Tag="Дата и время"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1">
                            <Label Content="Приоритет"/>
                            <ComboBox IsEnabled="False"
                                      Tag="Выберите приоритет"
                                      ToolTip="В текущей модели БД приоритет заявки не задан."/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,15,0">
                            <Label Content="Клиент"/>
                            <ComboBox ItemsSource="{Binding Clients}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Request.ClientId, Mode=TwoWay}"
                                      Tag="Укажите клиента"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2">
                            <Label Content="Тип обращения"/>
                            <ComboBox IsEnabled="False"
                                      Tag="Выберите тип обращения"
                                      ToolTip="В текущей модели БД тип обращения не задан (используйте наименование заявки)."/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,15,0">
                            <Label Content="Наименование"/>
                            <TextBox Text="{Binding Request.Title, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Краткое название заявки"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="3">
                            <Label Content="Назначенный сотрудник"/>
                            <ComboBox ItemsSource="{Binding Employees}"
                                      DisplayMemberPath="GetFullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Request.EmployeeId, Mode=TwoWay}"
                                      Tag="Укажите сотрудника"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,8,0,0">
                            <Label Content="Описание"/>
                            <TextBox TextWrapping="Wrap"
                                     Text="{Binding Request.Description}"
                                     Height="80"
                                     Tag="Добавьте описание заявки"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <!--<Expander Header="Услуги" IsExpanded="True" Grid.Row="4" Margin="0,16,0,0">
                    <Expander.Resources>
