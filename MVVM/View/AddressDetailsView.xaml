<UserControl x:Class="Telecom_ThesisProject.MVVM.View.AddressDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Border Padding="10" 
            CornerRadius="10" Background="White">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding GoBackCommand}"
                               Margin="0,0,5,0"
                               Padding="10"/>
                </StackPanel>

                <Separator Margin="5,2" Grid.Column="1"/>

                <ui:TextBlock Grid.Column="2"
                              Text="{Binding FullAddress, FallbackValue=Детали адреса}"
                              FontTypography="Subtitle"
                              VerticalAlignment="Center"/>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderBrush="Transparent">
                <TabItem Header="Точки монтажа" FontSize="12pt">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ui:Card Margin="0,0,0,5">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <ui:Button Content="Добавить точку монтажа"
                                   Command="{Binding AddMountingPointCommand}"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Margin="0,0,5,0" Appearance="Primary"/>

                                <Separator Margin="5,2"/>

                                <ui:Button Icon="{ui:SymbolIcon Edit24}" 
                                           Command="{Binding EditMountingPointCommand}" 
                                           Appearance="Transparent" Margin="5,0"/>
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                                           Command="{Binding DeleteMountingPointCommand}" 
                                           CommandParameter="{Binding SelectedMountingPoint}" 
                                           Appearance="Transparent" Margin="0,0,5,0"/>

                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" VerticalAlignment="Top" >
                            <ui:DataGrid ItemsSource="{Binding MountingPoints}"
                                      SelectedItem="{Binding SelectedMountingPoint, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <ui:DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding EditMountingPointCommand}"/>
                                </ui:DataGrid.InputBindings>
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding PointType.Name}" Width="*"/>
                                    <DataGridTextColumn Header="Дата монтажа" Binding="{Binding MountingDate, StringFormat={}{0:dd.MM.yy}}" Width="*"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding LocationDescription}" Width="*"/>
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </ui:Card>
                    </Grid>
                </TabItem>

                <TabItem Header="Сетевое оборудование" FontSize="12pt">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ui:Card Margin="0,0,0,5">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                                <ui:Button Content="Привязать устройство"
                                            Command="{Binding AddDeviceCommand}"
                                            Icon="{ui:SymbolIcon Link24}"
                                            Margin="0,0,5,0" Appearance="Primary"/>

                                <Separator Margin="5,2"/>

                                <ui:Button Icon="{ui:SymbolIcon LinkDismiss24}" 
                                           Command="{Binding UnbindDeviceCommand}"
                                           CommandParameter="{Binding SelectedDevice}"
                                           Margin="5,0"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" VerticalAlignment="Top">
                            <ui:DataGrid ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True" Grid.ColumnSpan="2">
                                <ui:DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding OpenDeviceDetailsCommand}"/>
                                </ui:DataGrid.InputBindings>
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.TypeName}" Width="*"/>
                                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Точка монтажа" 
                                                        Binding="{Binding MountingPoint.LocationDescription}" Width="*"/>
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </ui:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
