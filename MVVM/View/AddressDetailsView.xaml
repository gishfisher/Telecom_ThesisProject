<UserControl x:Class="Telecom_ThesisProject.MVVM.View.AddressDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="15,15,15,0">
            <TextBlock Text="{Binding FullAddress}"
                       FontSize="16pt"
                       FontWeight="DemiBold"
                       Foreground="#111827"
                       VerticalAlignment="Center"/>
            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Margin="20,0,0,0"
                    Padding="15,5"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="15,10,15,15" Background="Transparent" BorderBrush="Transparent">
            <TabItem Header="Точки монтажа" FontSize="12pt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:Card>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <ui:Button Content="Добавить точку монтажа"
                                       Command="{Binding AddMountingPointCommand}"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Margin="0,0,5,0"/>

                            <Separator Margin="5,2"/>

                            <ui:Button Icon="{ui:SymbolIcon Edit24}" 
                                       Command="{Binding EditMountingPointCommand}" 
                                       Appearance="Transparent" Margin="5,0"/>
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                                       Command="{Binding DeleteMountingPointCommand}" 
                                       CommandParameter="{Binding SelectedMountingPoint}" 
                                       Appearance="Transparent" Margin="0,0,5,0"/>

                        </StackPanel>
                    </ui:Card>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MountingPoints}"
                              SelectedItem="{Binding SelectedMountingPoint, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditMountingPointCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding PointType.Name}" Width="*"/>
                            <DataGridTextColumn Header="Дата монтажа" Binding="{Binding MountingDate, StringFormat={}{0:dd.MM.yy}}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding LocationDescription}" Width="*"/>
                            <!--<DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Редактировать"
                                                Command="{Binding DataContext.EditMountingPointCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="5,2"
                                                FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить"
                                                Command="{Binding DataContext.DeleteMountingPointCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="5,2"
                                                FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Сетевое оборудование" FontSize="12pt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:Card>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                            <ui:Button Content="Привязать устройство"
                                    Command="{Binding AddDeviceCommand}"
                                    Icon="{ui:SymbolIcon Link24}"
                                    Margin="0,0,5,0"/>

                            <Separator Margin="5,2"/>

                            <ui:Button Icon="{ui:SymbolIcon LinkDismiss24}" 
                                       Command="{Binding UnbindDeviceCommand}"
                                       CommandParameter="{Binding SelectedDevice}"
                                       Appearance="Transparent" Margin="5,0"/>
                        </StackPanel>
                    </ui:Card>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True" Grid.ColumnSpan="2">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding OpenDeviceDetailsCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.TypeName}" Width="*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
                            <DataGridTextColumn Header="Мониторинг" Binding="{Binding IsMonitored}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMonitored}" Value="False">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Точка монтажа" Binding="{Binding MountingPoint.LocationDescription}" Width="*"/>
                            <!--<DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Отвязать"
                                                Command="{Binding DataContext.UnbindDeviceCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="5,2"
                                                FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!--<TabItem Header="Порты и подключения" FontSize="12pt">
                <DataGrid ItemsSource="{Binding Ports}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
