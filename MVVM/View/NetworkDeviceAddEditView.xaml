<UserControl x:Class="Telecom_ThesisProject.MVVM.View.NetworkDeviceAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="900">

    <Border Padding="10"
            Background="White"
            CornerRadius="10">



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding CancelCommand}"
                               Padding="10"
                               Margin="0,0,5,0"
                               ToolTip="Назад"/>

                <ui:Button Icon="{ui:SymbolIcon Save16}"
                               Command="{Binding SaveCommand}"
                               Padding="10"
                               Margin="0,0,10,0"
                               Appearance="Primary"
                               ToolTip="Сохранить"/>

                <Separator Margin="5,2"/>

                <ui:TextBlock Text="{Binding DeviceTitle, FallbackValue=Добавление устройства}"
                                  VerticalAlignment="Center"
                                  FontTypography="Subtitle"/>
            </StackPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Общее">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:CardExpander Grid.Column="0"
                                             IsExpanded="True"
                                             Padding="10"
                                             Margin="0,0,10,0" VerticalAlignment="Top">

                                <ui:CardExpander.Header>
                                    <ui:TextBlock FontTypography="BodyStrong">
                                        Основная информация
                                    </ui:TextBlock>
                                </ui:CardExpander.Header>

                                <StackPanel>

                                    <Label Content="Имя устройства"/>
                                    <ui:TextBox PlaceholderText="Введите имя устройства"
                                                Text="{Binding Device.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Content="IP-Адрес"
                                           Margin="0,12,0,0"/>

                                    <ui:TextBox PlaceholderText="Введите IP-адрес"
                                                Text="{Binding Device.IpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Content="Тип устройства"
                                           Margin="0,12,0,0"/>

                                    <ComboBox ItemsSource="{Binding DeviceTypes}"
                                              DisplayMemberPath="TypeName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Device.DeviceTypeId, Mode=TwoWay}"/>

                                    <Label Content="Родительское устройство"
                                           Margin="0,12,0,0"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox ItemsSource="{Binding ParentCandidates}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedParent, Mode=TwoWay}"/>

                                        <ui:Button Grid.Column="1"
                                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                                   Content="Сбросить"
                                                   Margin="10,0,0,0"
                                                   Padding="10,5"
                                                   Command="{Binding ClearParentCommand}"/>
                                    </Grid>

                                    <Label Content="Дата и место установки"
                                           Margin="0,12,0,0"/>

                                    <Border Background="#FAFAFA"
                                            BorderBrush="#EEEEEE"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">

                                        <TextBlock Text="{Binding InstallDateAndMountingPoint}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.85"/>
                                    </Border>

                                </StackPanel>
                            </ui:CardExpander>

                            <StackPanel Grid.Column="1">

                                <ui:CardExpander IsExpanded="True"
                                                 Padding="10" VerticalAlignment="Top">

                                    <ui:CardExpander.Header>
                                        <ui:TextBlock FontTypography="BodyStrong">
                                            SNMP
                                        </ui:TextBlock>
                                    </ui:CardExpander.Header>

                                    <StackPanel>

                                        <Label Content="SNMP Профиль"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox ItemsSource="{Binding SnmpProfiles}"
                                                      DisplayMemberPath="SnmpProfileString"
                                                      SelectedItem="{Binding SelectedSnmpProfile, Mode=TwoWay}"/>

                                            <ui:Button Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       Padding="8"
                                                       Command="{Binding AddSnmpProfileCommand}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Add24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>

                                        <ui:HyperlinkButton Icon="{ui:SymbolIcon Settings24}"
                                                            Margin="0,8,0,0"
                                                            Padding="5"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding ManageSnmpProfilesCommand}">
                                            <TextBlock>
                                                Управление SNMP профилями
                                            </TextBlock>
                                        </ui:HyperlinkButton>

                                    </StackPanel>
                                </ui:CardExpander>

                                <!-- ERROR -->
                                <!--<Border Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <ui:SymbolIcon Symbol="ErrorCircle24"
                                                       Foreground="#EF4444"
                                                       Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="#EF4444"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding ErrorMessage}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                </Border>-->

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Проверка связи">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,0,0">

                            <ui:CardExpander IsExpanded="True"
                                             Padding="10">

                                <ui:CardExpander.Header>
                                    <ui:TextBlock FontTypography="BodyStrong">
                                        Диагностика устройства
                                    </ui:TextBlock>
                                </ui:CardExpander.Header>

                                <StackPanel>

                                    <WrapPanel Margin="0,0,0,10">

                                        <ui:Button Content="Ping (ICMP)"
                                                   Command="{Binding PingCommand}"
                                                   Padding="10"
                                                   Margin="0,0,5,5"/>

                                        <ui:Button Content="Опрос SNMP"
                                                   Command="{Binding PollSnmpCommand}"
                                                   Padding="10"
                                                   Margin="0,0,5,5"/>

                                        <ui:Button Content="Получить порты"
                                                   Command="{Binding GetPortsCommand}"
                                                   Padding="10"
                                                   Margin="0,0,5,5"/>

                                        <ui:Button Content="Проверить SSH"
                                                   Command="{Binding ProbeSshCommand}"
                                                   Padding="10"
                                                   Margin="0,0,5,5"/>
                                    </WrapPanel>

                                    <Label Content="Результат выполнения"/>

                                    <ui:TextBox Text="{Binding LastPollResult}"
                                                IsReadOnly="True"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                MinHeight="120"
                                                Margin="0,5,0,0"
                                                FontFamily="Consolas"
                                                PlaceholderText="Здесь появится результат опроса..."
                                                VerticalScrollBarVisibility="Auto"/>

                                </StackPanel>
                            </ui:CardExpander>

                            <ui:CardExpander Margin="0,10,0,0"
                                             IsExpanded="True"
                                             Padding="10">

                                <ui:CardExpander.Header>
                                    <ui:TextBlock FontTypography="BodyStrong">
                                        Состояние портов
                                    </ui:TextBlock>
                                </ui:CardExpander.Header>

                                <ui:DataGrid ItemsSource="{Binding DevicePorts}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             HeadersVisibility="Column"
                                             GridLinesVisibility="Horizontal">

                                    <ui:DataGrid.Columns>

                                        <DataGridTextColumn Header="Порт"
                                                            Binding="{Binding PortName}"
                                                            Width="120"/>

                                        <DataGridTemplateColumn Header="Uplink"
                                                                Width="90">

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsUplink}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Статус"
                                                            Binding="{Binding OperationalStatus}"
                                                            Width="120">

                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="TextAlignment"
                                                            Value="Center"/>

                                                    <Setter Property="VerticalAlignment"
                                                            Value="Center"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding OperationalStatus}"
                                                                     Value="Активен">
                                                            <Setter Property="Foreground"
                                                                    Value="#10B981"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding OperationalStatus}"
                                                                     Value="Неактивен">
                                                            <Setter Property="Foreground"
                                                                    Value="#EF4444"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding OperationalStatus}"
                                                                     Value="Тестирование">
                                                            <Setter Property="Foreground"
                                                                    Value="#3B82F6"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="RFC 1213"
                                                            Binding="{Binding StatusRawValue}"
                                                            Width="150"/>

                                    </ui:DataGrid.Columns>
                                </ui:DataGrid>
                            </ui:CardExpander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>