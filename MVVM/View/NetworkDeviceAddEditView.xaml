<UserControl x:Class="Telecom_ThesisProject.MVVM.View.NetworkDeviceAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="720">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Среда лаборатории" FontWeight="DemiBold" FontSize="13" Margin="0,0,0,4"/>
            <!--<TextBlock Text="{Binding LabInfoText}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>-->

            <Label Content="Имя устройства"/>
            <TextBox Text="{Binding Device.Name, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="IP-Адрес" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Device.IpAddress, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="SNMP community (v2c)" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Device.SnmpCommunity, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Тип устройства" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding DeviceTypes}"
                      DisplayMemberPath="TypeName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding Device.DeviceTypeId, Mode=TwoWay}"/>

            <Label Content="Точка монтажа" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding MountingPoints}"
                      DisplayMemberPath="DisplayLabel"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding Device.MountingPointId, Mode=TwoWay}"/>

            <Label Content="Родительское устройство" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="400"
                          ItemsSource="{Binding ParentCandidates}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedParent, Mode=TwoWay}"/>
                <Button Content="Сбросить" Margin="8,0,0,0" Padding="8,4"
                        Command="{Binding ClearParentCommand}"/>
            </StackPanel>

            <!--<Label Content="Производитель / модель / серийный номер" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Device.Vendor}" Width="140" Margin="0,0,8,0"/>
                <TextBox Text="{Binding Device.Model}" Width="180" Margin="0,0,8,0"/>
                <TextBox Text="{Binding Device.SerialNumber}" Width="200"/>
            </StackPanel>-->

            <CheckBox Content="Участвует в мониторинге (SNMP)" IsChecked="{Binding Device.IsMonitored}" Margin="0,12,0,0"/>

            <Label Content="Дата установки" Margin="0,8,0,0"/>
            <DatePicker SelectedDate="{Binding InstallDateUi, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>

            <Separator Margin="0,16,0,12"/>

            <TextBlock Text="Проверка связи" FontWeight="DemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Опрос SNMP (sysName, sysDescr)" Command="{Binding PollSnmpCommand}" Margin="0,0,8,0" Padding="10,6"/>
                <Button Content="Проверить TCP порт SSH (без авторизации)" Command="{Binding ProbeSshCommand}" Padding="10,6"/>
            </StackPanel>
            <TextBox Text="{Binding LastPollResult}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" Margin="0,8,0,0"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Назад" Command="{Binding CancelCommand}" Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
