<UserControl x:Class="Telecom_ThesisProject.MVVM.View.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="10"
            CornerRadius="10"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:TextBlock Text="Сотрудники"
                          FontTypography="Subtitle"
                          Padding="5"
                          Grid.Row="0"/>
            <ui:Card Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" 
                           Content="Добавить сотрудника" 
                           Command="{Binding AddCommand}" 
                           Margin="5,0" Appearance="Primary"/>

                    <Separator Margin="5,2"/>

                    <ui:Button Icon="{ui:SymbolIcon Edit24}" 
                           Command="{Binding EditCommand}" 
                           Margin="5,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                           Command="{Binding DeleteCommand}" 
                           Margin="0,0,5,0"/>

                    <!--<Separator Margin="5,2"/>-->

                    <!--<ui:TextBox PlaceholderText="Поиск по имени или IP" Icon="{ui:SymbolIcon Search24}" Width="300" 
                            Margin="5,0" Padding="5"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>-->
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Row="2" VerticalAlignment="Top" Margin="0,5,0,0">
                <ui:DataGrid ItemsSource="{Binding Employee}"
                          SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding GetFullNameIn}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding User.Role.Name}" Width="0.8*"/>
                        <DataGridTextColumn Header="Имя пользователя" Binding="{Binding User.Login}" Width="1.25*"/>
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding User.CreatedAt}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding User.IsActive}" Width="0.8*"/>
                    </ui:DataGrid.Columns>

                    <ui:DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding EditCommand}" />
                    </ui:DataGrid.InputBindings>
                </ui:DataGrid>
            </ui:Card>
        </Grid>
    </Border>
</UserControl>
