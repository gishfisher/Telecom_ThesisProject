<UserControl x:Class="Telecom_ThesisProject.MVVM.View.NetworkDeviceDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="{Binding Device.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Device.IpAddress}" FontSize="18" Foreground="Gray"
                       Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Button Content="Редактировать" Command="{Binding EditCommand}"
                    Margin="30,0,0,0" Padding="12,6"/>
            <Button Content="Назад" Command="{Binding GoBackCommand}"
                    Margin="10,0,0,0" Padding="12,6"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0">

            <TabItem Header="Порты устройства">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Обновить порты (SNMP)" Command="{Binding RefreshPortsCommand}" Width="150" Height="30"/>
                        <TextBox Width="200" Margin="20,0,0,0" Tag="Поиск порта..." VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Ports}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" SelectionMode="Single"
                              BorderBrush="#DDD" RowHeight="40" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="№" Binding="{Binding PortNumber}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Интерфейс" Binding="{Binding PortName}" Width="100" FontWeight="Bold" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Uplink" Binding="{Binding IsUplink}" Width="100" FontWeight="Bold" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Абонент" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ClientsList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding SelectedClient, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="FullName"
                                                  IsEditable="True" 
                                                  TextSearch.TextPath="FullName"
                                                  BorderThickness="0"
                                                  VerticalContentAlignment="Center">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUplink}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!--<DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Управлять" 
                                                Command="{Binding DataContext.ManagePortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Конфигурация">
                <ScrollViewer Margin="0,15,0,0">
                    <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="SNMP Community" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Device.SnmpCommunity}" Height="30" Margin="0,0,0,15"/>

                        <TextBlock Text="Родительское устройство (Uplink)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ParentDevices}" DisplayMemberPath="Name" Height="30" Margin="0,0,0,15"/>

                        <Button Content="Сохранить изменения" Command="{Binding SaveCommand}" 
                                Width="150" Height="35" HorizontalAlignment="Left" Background="#007ACC" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Инструменты">
                <StackPanel Margin="0,20,0,0">
                    <Button Content="Открыть SSH Консоль" Command="{Binding OpenSshCommand}" Width="200" Height="40" Margin="0,0,0,10"/>
                    <Button Content="Перезагрузить устройство" Command="{Binding RebootCommand}" Width="200" Height="40" Background="#FFF1F1" Foreground="#D11"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
