<UserControl x:Class="Telecom_ThesisProject.MVVM.View.NetworkDeviceDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Telecom_ThesisProject.MVVM.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Margin="10" Padding="10" CornerRadius="10" 
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="{Binding Device.Name, StringFormat={}Карточка оборудования «{0}»}" FontSize="14pt" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Device.IpAddress}" FontSize="18" Foreground="Gray"
                   Margin="15,0,0,0" VerticalAlignment="Bottom"/>
                <Button Content="Редактировать" Command="{Binding EditCommand}"
                Margin="30,0,0,0" Padding="12,6"/>
                <Button Content="Назад" Command="{Binding GoBackCommand}"
                Margin="10,0,0,0" Padding="12,6"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0">

                <TabItem Header="Общее">
                    <TabItem.Resources>
                        <Style x:Key="ZebraStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="InnerBorder" 
                                                Background="Transparent" 
                                                Padding="5">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="InnerBorder" Property="Background" Value="#7FF7F6F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabItem.Resources>
                    
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Общая информация" 
                                   FontSize="14" 
                                   Margin="5,0,0,15"/>

                        <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Top">
                            <ListBox Background="Transparent" 
                                     BorderThickness="0"
                                     AlternationCount="2"
                                     ItemContainerStyle="{StaticResource ZebraStyle}"
                                     ItemsSource="{Binding DeviceDetailsList}">
                                <ListBox.Items>
                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Имя устройства"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Device.Name}"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IP-Адрес"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Device.IpAddress}"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Тип устройства"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DeviceTypeName}" />
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Время работы (Uptime)"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Device.Uptime, FallbackValue='14д. 05ч. 12м.'}" />
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SNMP Профиль"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Статус мониторинга"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding IsMonitoredText}" />
                                            </StackPanel>
                                        </Grid>
                                    </ListBoxItem>

                                    <ListBoxItem>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Местоположение"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Device.Location, FallbackValue='Серверная А-12'}"/>
                                                <ui:HyperlinkButton Icon="{ui:SymbolIcon MoreCircle32}"
                                                                    Command="{Binding}" 
                                                                    Grid.Column="1"
                                                                    Padding="1"
                                                                    Margin="10,0">
                                                    <TextBlock>
                                                        <Underline>Подробнее о точке монтажа</Underline>
                                                    </TextBlock>
                                                </ui:HyperlinkButton>
                                            </StackPanel>
                                        </Grid>
                                    </ListBoxItem>
                                </ListBox.Items>
                            </ListBox>
                        </ui:Card>
                    </Grid>
                </TabItem>

                <TabItem Header="Порты устройства">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Обновить порты (SNMP)" Command="{Binding RefreshPortsCommand}"/>
                            <ui:TextBox PlaceholderText="Поиск порта" Width="300" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Ports}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" SelectionMode="Single"
                          BorderBrush="#DDD" RowHeight="40" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="№" Binding="{Binding PortNumber}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Интерфейс" Binding="{Binding PortName}" Width="100" FontWeight="Bold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Uplink" Binding="{Binding IsUplink}" Width="100" FontWeight="Bold" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Абонент" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ClientsList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding SelectedClient, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="FullName"
                                              IsEditable="True" 
                                              TextSearch.TextPath="FullName"
                                              BorderThickness="0"
                                              VerticalContentAlignment="Center">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUplink}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--<DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Управлять" 
                                            Command="{Binding DataContext.ManagePortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Инструменты">
                    <StackPanel Margin="0,20,0,0">
                        <Button Content="Открыть SSH Консоль" Command="{Binding OpenSshCommand}" Width="200" Height="40" Margin="0,0,0,10"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>
