<UserControl x:Class="Telecom_ThesisProject.MVVM.View.MountingPointAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="800"
             Background="Transparent">

    <Border Padding="10"
            CornerRadius="10"
            Background="White">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Command="{Binding CancelCommand}"
                               Padding="10"
                               Margin="0,0,5,0"
                               ToolTip="Назад"/>

                    <ui:Button Icon="{ui:SymbolIcon Save20}"
                               Command="{Binding SaveCommand}"
                               Padding="10"
                               ToolTip="Сохранить"/>

                    <Separator Margin="10,2"/>

                    <ui:TextBlock Text="{Binding Title,
                                                 FallbackValue=Точка монтажа}"
                                  VerticalAlignment="Center"
                                  FontTypography="Subtitle"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1">

                    <ui:CardExpander IsExpanded="True"
                                     Padding="10">

                        <ui:CardExpander.Header>
                            <ui:TextBlock FontTypography="BodyStrong">
                                Информация о точке монтажа
                            </ui:TextBlock>
                        </ui:CardExpander.Header>

                        <Grid Margin="0,10,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="Тип точки монтажа"
                                          VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PointTypes}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedPointTypeId}"/>

                            <ui:TextBlock Grid.Row="1"
                                          Text="Тип точки размещения"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Center"/>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,12,0,0"
                                      ItemsSource="{Binding PlacementTypes}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedPlacementTypeId}"/>

                            <ui:TextBlock Grid.Row="2"
                                          Text="Описание расположения"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Top"/>

                            <ui:TextBox Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Text="{Binding LocationDescription,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        Height="80"
                                        TextWrapping="Wrap"
                                        PlaceholderText="Например: 3 этаж, серверная, стойка №2"/>

                        </Grid>
                    </ui:CardExpander>

                    <!--<StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <ui:SymbolIcon Symbol="ErrorCircle24"
                                       Foreground="#EF4444"
                                       Margin="0,0,8,0"/>

                        <ui:TextBlock Text="{Binding ErrorMessage}"
                                      Foreground="#EF4444"
                                      TextWrapping="Wrap"/>
                    </StackPanel>-->
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>