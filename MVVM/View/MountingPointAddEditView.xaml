<UserControl x:Class="Telecom_ThesisProject.MVVM.View.MountingPointAddEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="450"
             Background="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="14pt" FontWeight="DemiBold" Margin="0,0,0,15"/>

            <Label Content="Тип точки монтажа"/>
            <ComboBox ItemsSource="{Binding PointTypes}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedPointTypeId}"/>

            <Label Content="Тип точки размещения"/>
            <ComboBox ItemsSource="{Binding}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <Label Content="Описание расположения (необязательно)"/>
            <TextBox Text="{Binding LocationDescription, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="60"
                     TextWrapping="Wrap"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,15,0,5"/>
            <Button Content="Назад" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
