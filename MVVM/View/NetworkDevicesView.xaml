<UserControl x:Class="Telecom_ThesisProject.MVVM.View.NetworkDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Padding="10"
            CornerRadius="10"
            Background="White">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:TextBlock Text="Сетевые устройства"
                              FontTypography="Subtitle"
                              Padding="5"
                              Grid.Row="0"/>
            <ui:Card Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" 
                               Content="Добавить устройство" 
                               Command="{Binding AddCommand}" 
                               Margin="5,0"/>

                    <Separator Margin="5,2"/>

                    <ui:Button Icon="{ui:SymbolIcon Edit24}" 
                               Command="{Binding EditCommand}" 
                               Margin="5,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                               Command="{Binding DeleteCommand}" 
                               Margin="0,0,5,0"/>

                    <Separator Margin="5,2"/>
                    
                    <ui:TextBox PlaceholderText="Поиск по имени или IP" Icon="{ui:SymbolIcon Search24}" Width="300" 
                                Margin="5,0" Padding="5"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="2" VerticalAlignment="Top" Margin="0,5,0,0">
                <ui:DataGrid ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.TypeName}" Width="*"/>
                        <DataGridTextColumn Header="Родитель" Binding="{Binding ParentDevice.Name}" Width="*"/>
                        <DataGridTemplateColumn Header="Точка монтажа" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TxtBlock" TextAlignment="Center" Text="{Binding MountingPoint.Address.GetFullAddress}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding MountingPoint.Address.GetFullAddress}" Value="{x:Null}">
                                            <Setter TargetName="TxtBlock" Property="Text" Value="Не смонтировано"/>
                                            <Setter TargetName="TxtBlock" Property="Foreground" Value="#FFB1B1B1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MountingPoint.Address.GetFullAddress}" Value="">
                                            <Setter TargetName="TxtBlock" Property="Text" Value="Не смонтировано"/>
                                            <Setter TargetName="TxtBlock" Property="Foreground" Value="#FFB1B1B1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </ui:DataGrid.Columns>
                    <ui:DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenDeviceDetailsCommand}"/>
                    </ui:DataGrid.InputBindings>
                </ui:DataGrid>
            </ui:Card>
        </Grid>
    </Border>
</UserControl>
