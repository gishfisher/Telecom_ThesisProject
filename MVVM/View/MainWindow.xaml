<Window x:Class="Telecom_ThesisProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Telecom_ThesisProject"
        xmlns:viewModel="clr-namespace:Telecom_ThesisProject.MVVM.ViewModel"
        xmlns:view="clr-namespace:Telecom_ThesisProject.MVVM.View"
        xmlns:utils="clr-namespace:Telecom_ThesisProject.Utilities"
        mc:Ignorable="d"
        Title="Telecom"
        WindowStartupLocation="CenterScreen" 
        MinHeight="550" MinWidth="800"
        Height="620" Width="1025">
    
    <Window.DataContext>
        <viewModel:NavigationViewModel/>
    </Window.DataContext>

    <Grid Background="#F4F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="TELECOM" Foreground="#1E293B" FontSize="16pt"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="20,0,0,0"/>
        </StackPanel>

        <view:TopMenuView Grid.Row="1"/>

        <ContentControl Grid.Row="2" Grid.ColumnSpan="2"
                    Margin="10" 
                    Background="#FFFFFF"
                    Content="{Binding CurrentView}"/>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="#FFFFFF"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="#2C3E50"/>
    </Grid>
</Window>
