<Window x:Class="Telecom_ThesisProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Telecom_ThesisProject"
        xmlns:viewModel="clr-namespace:Telecom_ThesisProject.MVVM.ViewModel"
        xmlns:utils="clr-namespace:Telecom_ThesisProject.Utilities"
        mc:Ignorable="d"
        Title="Telecom"
        MinHeight="550" MinWidth="800"
        Height="620" Width="1025">
    
    <Window.DataContext>
        <viewModel:NavigationViewModel/>
    </Window.DataContext>

    <Grid Background="#F4F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="TELECOM" Foreground="#1E293B" FontSize="18pt"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="20,0,0,0"/>

            <!--<TextBox Width="250"
                     VerticalContentAlignment="Center" 
                     HorizontalAlignment="Left"
                     Grid.Column="1"
                     Margin="5"
                     FontSize="12pt"
                     Style="{StaticResource ModernTextBox}"/>-->

        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsAuthenticated, 
                         Converter={StaticResource BoolToVisibilityConverter}}"
                    Orientation="Horizontal">

            <RadioButton Content="Home"
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     IsChecked="True"
                     Command="{Binding HomeViewCommand}"/>

            <RadioButton Content="Clients" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding ClientViewCommand}"/>

            <RadioButton Content="Requests" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding RequestsViewCommand}"/>

            <RadioButton Content="Employees" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding EmployeesViewCommand}"/>

            <RadioButton Content="Tariffs" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding TariffsViewCommand}"/>

            <RadioButton Content="Services" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding ServicesViewCommand}"/>

            <RadioButton Content="Connections" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding ConnectionsViewCommand}"/>

            <RadioButton Content="Network Devices" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding NetworkDevicesViewCommand}"/>

            <RadioButton Content="Logout" 
                     Height="50" 
                     Foreground="#FFFFFF"
                     FontSize="14pt"
                     Style="{StaticResource MenuButtonTheme}"
                     Command="{Binding LogoutCommand}"/>

        </StackPanel>

        <ContentControl Grid.Row="2" Grid.ColumnSpan="2"
                    Margin="10" 
                    Background="#FFFFFF"
                    Content="{Binding CurrentView}"/>


        <Grid Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="#FFFFFF"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="-1" Background="#2C3E50"/>
    </Grid>
</Window>
